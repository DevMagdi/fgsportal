<IfModule mod_rewrite.c>
    RewriteEngine On

    # سيب الملفات والمجلدات الحقيقية زي ما هي
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # أي طلب يبدأ بـ api/ يروح على Laravel
    RewriteRule ^api/(.*)$ system/public/index.php [L]
</IfModule>