# Base URL of the Laravel backend (no trailing /api — the app appends it).
# Example: http://localhost:8000  or  https://api.example.com
VITE_API_BASE_URL=http://localhost:8000
# Dev-only: when true, the API layer serves realistic demo data shaped exactly
# like the Laravel responses (useful before the backend is reachable).
# Production builds must set this to false.
VITE_DEMO_MODE=false
