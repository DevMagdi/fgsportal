# Leave blank for same-origin /api requests (recommended).
# A public HTTPS Laravel origin can be supplied for a separately hosted API.
VITE_API_BASE_URL=

# true enables a browser-local demo workspace; use false for real Laravel data.
VITE_DEMO_MODE=false

# Must match Laravel config/app.php's timezone for calendar dates and scheduled times.
VITE_BMS_SERVER_TIME_ZONE=Africa/Cairo

# Optional Vite server-side proxy for local Laravel development. This value is
# never sent to the browser. Uncomment if Laravel is running on this machine.
# BMS_PROXY_TARGET=http://127.0.0.1:8000
