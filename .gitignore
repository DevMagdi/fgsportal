# ==========================================================
# FGS Connect — root .gitignore
# Monorepo: backend/ (Laravel 8) + frontend/ (Angular 13)
# ==========================================================

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
**/firebase-adminsdk-*.json
**/google-service-account*.json
/cert/
**/public/cert/

# ---- PHP / Laravel (backend) ----
backend/vendor/
vendor/
node_modules/
backend/public/hot
backend/public/storage
backend/storage/*.key
.phpunit.result.cache
.phpunit.cache/
*.log
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/storage/framework/views/*.php
!backend/storage/framework/views/.gitignore
Homestead.json
Homestead.yaml
docker-compose.override.yml

# ---- Node / Angular (frontend) ----
dist/
tmp/
out-tsc/
.bazel-out/
**/node_modules/
.angular/
.sass-cache/
coverage/
connect.lock
libpeerconnection.log
npm-debug.log*
yarn-error.log*
testem.log
/typings
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# ---- Built/deployed bundles (source of truth is frontend/) ----
# Never commit production builds at the repo root or in hosting folders.
/main.js
/main.*.js
/runtime.js
/runtime.*.js
/polyfills.js
/polyfills.*.js
/scripts.js
/scripts.*.js
/vendor.js
/vendor.*.js
/styles.css
/styles.*.css
/*.map
*.chunk.js

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
